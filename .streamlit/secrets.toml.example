# Copy to .streamlit/secrets.toml (which is gitignored) and fill in. On Streamlit Community Cloud, paste the same
# [database] block into the app's Settings > Secrets. Connect as app_login, never as the postgres owner.
[database]
url = "postgresql://app_login.<project-ref>:<app_login password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
org_id = "<your organization uuid>"

# MongoDB Atlas (reviews, plans, tools). Atlas: Connect > Drivers > Python. Put the real password in place of
# <password> and URL-encode special characters (@ is %40). Connect as a user with only readWrite on janota_fin.
# Test it with:  py -m mongodb.check_connection
[mongodb]
uri = "mongodb+srv://AutoRek_app:<password>@<cluster>.mongodb.net/"
database = "janota_fin"

# Real sign-in (OpenID Connect) through Streamlit's st.login. Works with Google, Microsoft Entra ID, Okta, Auth0 ...
# Redirect URI in the provider's console: http://localhost:8501/oauth2callback (local) and https://<your domain>/oauth2callback.
# Entra example server_metadata_url: https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# Google:                           https://accounts.google.com/.well-known/openid-configuration
# cookie_secret is any long random string. Keep the client secret out of the repository.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "<a long random string>"
client_id = "<client id>"
client_secret = "<client secret>"
server_metadata_url = "<provider's .well-known/openid-configuration URL>"

# Who counts as a verified person in the run history: signed in AND on this list. With neither key set, nobody is verified.
[access]
emails = ["preparer@yourcompany.com"]
domains = ["yourcompany.com"]
