# Copy to .streamlit/secrets.toml (which is gitignored) and fill in. On Streamlit Community Cloud, paste the same
# [database] block into the app's Settings > Secrets. Connect as app_login, never as the postgres owner.
[database]
url = "postgresql://app_login.<project-ref>:<app_login password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
org_id = "<your organization uuid>"

# MongoDB Atlas (reviews, plans, tools). Atlas: Connect > Drivers > Python. Put the real password in place of
# <password> and URL-encode special characters (@ is %40). Connect as a user with only readWrite on janota_fin.
# Test it with:  py -m mongodb.check_connection
[mongodb]
uri = "mongodb+srv://AutoRek_app:<password>@<cluster>.mongodb.net/"
database = "janota_fin"
